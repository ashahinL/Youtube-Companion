{
  "name": "youtube-companion",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.2"
  },
  "description": "Tooling manifest for the Companion for YouTube extension. Chrome ignores this file; it exists so `npm test` works.",
  "scripts": {
    "test": "node test/run-all.js --summary",
    "test:verbose": "node test/run-all.js",
    "test:json": "node test/run-all.js --json",
    "check": "node test/check-syntax.js",
    "test:live": "node test/live.js",
    "pack": "node scripts/pack.js",
    "shots": "node scripts/shots.js"
  }
}
