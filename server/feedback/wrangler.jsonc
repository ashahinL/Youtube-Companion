{
  "name": "companion-feedback",
  "main": "worker.js",
  "compatibility_date": "2026-09-25",
  "routes": [
    { "pattern": "feedback.ammarshahin.dev", "custom_domain": true }
  ],
  "vars": {
    "FEEDBACK_REPO": "ashahinL/companion-feedback"
  },
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // The note people type must not land in request logs.
  "observability": { "enabled": false }
}
